{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["esnext", "dom", "dom.iterable", "dom.asynciterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noImplicitAny": false,
    "types": [
      "node",
    ],
  },
}
