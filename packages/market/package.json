{
  "name": "@cordisjs/market",
  "description": "Plugin market for Cordis",
  "version": "0.7.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./client": "./client/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "scripts": {
    "lint": "eslint src --ext .ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cordiverse/webui.git",
    "directory": "packages/market"
  },
  "bugs": {
    "url": "https://github.com/cordiverse/webui/issues"
  },
  "keywords": [
    "cordis",
    "plugin",
    "market",
    "webui"
  ],
  "cordis": {
    "public": [
      "dist"
    ],
    "description": {
      "en": "Install and manage Cordis plugins from the built-in market",
      "zh": "从内置市场安装和管理 Cordis 插件"
    },
    "service": {
      "required": [
        "std:fs",
        "std:http",
        "webui"
      ],
      "implements": [
        "installer"
      ]
    }
  },
  "peerDependencies": {
    "@cordisjs/fs": "^2.0.0-rc.1",
    "@cordisjs/http": "^2.0.0-rc.0",
    "@cordisjs/webui": "^0.10.0",
    "cordis": "^4.0.0-rc.14"
  },
  "devDependencies": {
    "@cordisjs/client": "^0.10.0",
    "@cordisjs/fs": "^2.0.0-rc.1",
    "@cordisjs/fs-node": "^1.0.0-rc.0",
    "@cordisjs/http": "^2.0.0-rc.0",
    "@cordisjs/include": "^2.0.0-rc.1",
    "@cordisjs/loader": "^1.0.0-rc.11",
    "@cordisjs/logger-console": "^1.0.2",
    "@cordisjs/server": "^2.0.0-rc.0",
    "@cordisjs/timer": "^2.0.0-rc.0",
    "@cordisjs/ui-market": "^4.6.1",
    "@cordisjs/webui": "^0.10.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "cordis": "^4.0.0-rc.14",
    "vue": "^3.5.45",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "cosmokit": "^1.8.1",
    "schemastery": "^3.18.0",
    "semver": "^7.8.6"
  }
}
