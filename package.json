{
  "name": "@root/cordis-webui",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "external/*",
    "external/*/external/*",
    "external/*/packages/*",
    "packages/*"
  ],
  "license": "MIT",
  "scripts": {
    "lint": "oxlint",
    "yakumo": "node --expose-internals --import tsx --import @cordisjs/unyaml node_modules/yakumo/lib/cli.js",
    "postinstall": "yarn yakumo postinstall",
    "build": "yarn yakumo build",
    "dev": "yarn workspace @cordisjs/online dev",
    "serve": "node --import tsx packages/online/src/serve",
    "test": "yarn yakumo vitest --import tsx",
    "test:text": "shx rm -rf coverage && yarn test --coverage --coverage.reporter text",
    "test:json": "shx rm -rf coverage && yarn test --coverage --coverage.reporter json",
    "test:html": "shx rm -rf coverage && yarn test --coverage --coverage.reporter html"
  },
  "devDependencies": {
    "@cordisjs/fs": "^2.0.0-rc.1",
    "@cordisjs/fs-node": "^1.0.0-rc.0",
    "@cordisjs/http": "^2.0.0-rc.0",
    "@cordisjs/include": "^2.0.0-rc.1",
    "@cordisjs/loader": "^1.0.0-rc.11",
    "@cordisjs/logger-console": "^1.0.2",
    "@cordisjs/oxlint-config": "^1.0.0",
    "@cordisjs/server": "^2.0.0-rc.0",
    "@cordisjs/server-proxy": "^2.0.0-rc.0",
    "@cordisjs/timer": "^2.0.0-rc.0",
    "@cordisjs/unyaml": "^3.0.0",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.5.1",
    "cordis": "^4.0.0-rc.14",
    "esbuild": "^0.28.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.93.0",
    "shx": "^0.4.0",
    "tsx": "npm:@cordisjs/tsx@4.23.15-fix.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.5",
    "yakumo": "^4.0.0",
    "yakumo-esbuild": "^4.0.0",
    "yakumo-tsc": "^4.0.0",
    "yakumo-vitest": "^2.0.0"
  }
}
